# Node API + Docker MySQL（密码仅供后端读取）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=footprint_map
MYSQL_USER=footprint
MYSQL_PASSWORD=replace-with-your-local-password
MYSQL_ROOT_PASSWORD=replace-with-your-local-root-password
API_PORT=3001
API_HOST=127.0.0.1
# 可选：私有图片目录（绝对路径）；迁移和运行使用同一路径
UPLOAD_DIRECTORY=
# Docker Hub 无法连接时可使用：public.ecr.aws/docker/library/mysql:8.4
MYSQL_IMAGE=mysql:8.4
# 高德开放平台 Web 服务类型 Key，仅由后端读取
AMAP_WEB_SERVICE_KEY=

# 必须与浏览器地址精确一致（含协议、域名与端口，无尾部 /），生产使用 https
APP_ORIGIN=http://localhost:5173
# 注册默认关闭；配置 SMTP_URL / MAIL_FROM 后才可启用
AUTH_REGISTRATION_ENABLED=false
SMTP_URL=
MAIL_FROM=
# 生产：NODE_ENV=production，Cookie 自动 Secure；HTTPS 反向代理只信任已确认的跳数
TRUST_PROXY_HOPS=
# 可选：迁移账号独立于仅 DML 的运行账号，运行服务不再执行 DDL
MIGRATION_MYSQL_USER=
MIGRATION_MYSQL_PASSWORD=
# 可选：跨主机 MySQL TLS CA PEM，换行可写为 \n
MYSQL_SSL_CA=
# 可选：独立测试库管理员；缺省使用 root / MYSQL_ROOT_PASSWORD
TEST_MYSQL_ADMIN_USER=
TEST_MYSQL_ADMIN_PASSWORD=

# 每个账号最多一个还原；所有API实例必须使用相同的全局槽位数（1–8）
RESTORE_CONCURRENCY=2
# 可选：受保护运维接口的独立随机令牌，至少32字符；不下发前端
OPERATIONS_TOKEN=
OPERATIONS_URL=http://127.0.0.1:3001/api/operations/status
# 图片磁盘可用空间低于此值时告警（默认1GiB）
OPS_MIN_FREE_BYTES=1073741824
# 系统备份离线探测地址；所有API实例必须先停止写入
API_HEALTH_URL=http://127.0.0.1:3001/api/health

# 实验画布图片路径，P4验收前默认关闭；缓存必须与驻留同时启用。
VITE_CANVAS_IMAGE_RESIDENCY=false
VITE_CANVAS_IMAGE_CACHE=false
