{
  "name": "footprint-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "build": "vite build --configLoader runner",
    "lint": "oxlint",
    "preview": "vite preview --configLoader runner",
    "test": "node --max-old-space-size=512 --max-semi-space-size=8 node_modules/vitest/vitest.mjs run --configLoader runner",
    "test:watch": "node --max-old-space-size=512 --max-semi-space-size=8 node_modules/vitest/vitest.mjs --configLoader runner",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --configLoader runner",
    "start": "node server/index.js",
    "db:up": "docker compose up -d --wait mysql",
    "db:up:autodl": "bash scripts/db-up-autodl.sh",
    "db:down": "docker compose stop mysql",
    "db:migrate": "node scripts/migrate-database.js",
    "db:create-user": "node scripts/create-user.js",
    "assets:gc": "node scripts/cleanup-assets.js",
    "maintenance": "node scripts/maintenance.js",
    "ops:check": "node scripts/check-operations.js",
    "backup:system": "node scripts/system-backup.js",
    "backup:verify": "node scripts/verify-system-backup.js",
    "backup:drill": "node scripts/restore-drill.js",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:security": "node --test server/auth.test.js && npm test -- tests/assets-security.test.js tests/ownership-migration.test.js tests/private-api-boundary.test.js tests/ownership.test.js tests/ownership-routes.test.js",
    "test:api": "node scripts/test-security-db.js",
    "test:smoke": "npm run build && node scripts/publication-ui-smoke.mjs",
    "test:canvas-ui": "npm run build && node scripts/canvas-ui-smoke.mjs",
    "test:image-resources": "node scripts/image-resource-ui-smoke.mjs",
    "test:canvas-perf": "npm run build && node scripts/canvas-image-performance.mjs",
    "test:layout-migration": "node scripts/test-layout-version-migration.js",
    "test:layout-lifecycle": "node scripts/test-layout-lifecycle.js",
    "test:e2e": "npm run build && node scripts/test-security-db.js --e2e",
    "test:canvas-residency": "node scripts/canvas-residency-ui-smoke.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.34.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "three": "^0.149.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.6",
    "jsdom": "^30.0.1",
    "oxlint": "^1.90.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
