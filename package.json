{
  "name": "footprint-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "start": "node server/index.js",
    "db:up": "docker compose up -d --wait mysql",
    "db:up:autodl": "bash scripts/db-up-autodl.sh",
    "db:down": "docker compose stop mysql",
    "test:api": "node --test --test-concurrency=1 server/api.test.js server/journal.test.js server/notebooks.test.js server/notebook-covers.test.js",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.34.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "three": "^0.149.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.6",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
